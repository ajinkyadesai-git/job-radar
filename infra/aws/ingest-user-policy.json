{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["dev/*", "prod/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteRawStateOps",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/dev/raw/*",
        "arn:aws:s3:::BUCKET_NAME/dev/state/*",
        "arn:aws:s3:::BUCKET_NAME/dev/ops/*",
        "arn:aws:s3:::BUCKET_NAME/prod/raw/*",
        "arn:aws:s3:::BUCKET_NAME/prod/state/*",
        "arn:aws:s3:::BUCKET_NAME/prod/ops/*"
      ]
    }
  ]
}
