# Copy to .env (git-ignored) and fill in. Never commit real values.

# Environment: dev or prod. Where raw files go: s3 or local (./data).
JOBRADAR_ENV=dev
JOBRADAR_DEST=s3

# S3 bucket from docs/setup-aws.md. dev and prod share one bucket under different prefixes.
JOBRADAR_S3_BUCKET=
JOBRADAR_S3_PREFIX=dev
JOBRADAR_AWS_REGION=us-west-2

# AWS CLI profile used by the ingest (created in docs/setup-aws.md).
AWS_PROFILE=job-radar-ingest

# Databricks Free Edition: SQL warehouse connection details and personal access token.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# AI assistant (jobradar ask). Create a key at console.anthropic.com with a monthly spend limit.
ANTHROPIC_API_KEY=
# Optional: which Claude model the assistant uses (default claude-sonnet-5-5)
JOBRADAR_AGENT_MODEL=

# API (jobradar serve). Every endpoint except /health needs header X-API-Key with this value.
# Make a long random one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBRADAR_API_KEY=

# Amazon Bedrock (jobradar ask/eval --provider bedrock). The model is a Bedrock inference
# profile id (aws bedrock list-inference-profiles); AWS credentials come from this profile.
JOBRADAR_BEDROCK_MODEL=
JOBRADAR_BEDROCK_PROFILE=jobradar-admin
JOBRADAR_BEDROCK_REGION=us-west-2
